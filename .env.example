# near-kit-tool-box env example
# Copy to .env and fill in real values (do NOT commit .env)
# =================================================
# Network: testnet (default) or mainnet
NEAR_KIT_NETWORK=testnet
# NEAR_KIT_NETWORK=mainnet
# Signing account + key (required for any write tx)
NEAR_KIT_ACCOUNT_ID=alice.testnet
NEAR_KIT_PRIVATE_KEY=ed25519:YOUR_PRIVATE_KEY_HERE
# =================================================
# NEP-366 relayer — submits the SignedDelegateAction on-chain and pays gas.
# The relayer account must exist and hold enough NEAR for gas.
NEAR_KIT_RELAYER_ACCOUNT_ID=gas.sleet.near
NEAR_KIT_RELAYER_PRIVATE_KEY=ed25519:YOUR_PRIVATE_KEY_HERE
# =================================================
